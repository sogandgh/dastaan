# macOS
.DS_Store

# Local Claude Code config — contains machine-specific absolute paths
.claude/

# Secrets — the ElevenLabs key lives in browser localStorage, never on disk.
# These patterns exist so an accidental local config file can't be committed.
.env
.env.*
!.env.example
config.local.js
*.key

# Personal voice recordings (the app now synthesises speech instead)
audio/

# Generated card/story images — runtime data that lives on the server,
# differs per deployment, and must survive `git pull` untouched. The
# vocabulary/story records themselves now live in Postgres, not here.
/data/

# npm dependencies (first ones this project has ever had — @supabase/supabase-js)
node_modules/
dist/
