# Copy this file to .env and fill in real values: cp .env.example .env
# .env is gitignored, nothing here ever gets committed.

# ElevenLabs (text-to-speech). Needs text_to_speech + voices_read permissions.
ELEVENLABS_API_KEY=

# OpenAI (story writing, flashcard translation + illustration).
OPENAI_API_KEY=

# Supabase (sign in / sign up, and where each family's data lives).
# Project URL and the anon/publishable key from Project Settings -> API.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional, all have sensible defaults, uncomment only to override.
# PORT=8000
# OPENAI_MODEL=gpt-5-mini
# OPENAI_STORY_MODEL=gpt-5
# OPENAI_IMAGE_MODEL=gpt-image-1-mini
